# Viagem na Lupa — Apache / LiteSpeed (Hostinger)

# HTTPS obrigatório
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# canônico SEM www: www.viagemnalupa.com.br -> viagemnalupa.com.br
RewriteCond %{HTTP_HOST} ^www\.viagemnalupa\.com\.br$ [NC]
RewriteRule ^(.*)$ https://viagemnalupa.com.br/$1 [R=301,L]

# página de erro
ErrorDocument 404 /404.html

# compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml
</IfModule>

# cache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  # HTML: nada de cache. Os arquivos com ?v=hash podem ficar um ano no
  # navegador porque o nome muda quando o conteúdo muda. O HTML não tem
  # hash — se ele ficar cacheado, o leitor continua vendo a página velha
  # depois do deploy, e foi exatamente isso que aconteceu.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# segurança básica
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # revalida o HTML a cada visita; o navegador ainda economiza banda com
  # o ETag, mas nunca serve conteúdo vencido sem perguntar ao servidor
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # os estáticos versionados podem ficar parados um ano, com segurança
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

Options -Indexes
