# Viagem na Lupa — finais de linha
# O site roda num servidor Linux (Hostinger), então tudo fica em LF,
# tanto no repositório quanto no disco. Evita erro 500 por .htaccess com CRLF.

* text=auto eol=lf

.htaccess  text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.xml      text eol=lf
*.txt      text eol=lf
*.md       text eol=lf
*.svg      text eol=lf

# binários: nunca converter
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
